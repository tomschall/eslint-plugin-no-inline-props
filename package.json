{
  "name": "eslint-plugin-no-inline-props",
  "version": "1.0.4",
  "description": "ESLint rule to prevent passing inline objects, functions or JSX as props (causes unnecessary rerenders).",
  "main": "index.cjs",
  "type": "commonjs",
  "exports": {
    ".": {
      "require": "./index.cjs"
    }
  },
  "files": [
    "dist",
    "index.cjs"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "react",
    "performance",
    "inline",
    "memo"
  ],
  "author": "Thomas Schallert",
  "license": "MIT",
  "peerDependencies": {
    "eslint": "^8.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.11",
    "@typescript-eslint/rule-tester": "^8.27.0",
    "@typescript-eslint/utils": "^8.27.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.0",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "test": "jest",
    "build": "tsc -p tsconfig.build.json"
  }
}
